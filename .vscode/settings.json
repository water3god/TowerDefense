{
  "stylua.targetReleaseVersion": "latest",
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "^Zap\\/[^\\/]+\\.zap$",
        "cmd": "zap ${file}",
        "runIn": "terminal"
      }
    ]
  }
}
